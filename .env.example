POSTGRES_DB=card_platform
POSTGRES_USER=card_platform
POSTGRES_PASSWORD=card_platform
DATABASE_URL=postgresql://card_platform:card_platform@localhost:5432/card_platform
DEFAULT_CURRENCY=CNY
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
VISION_API_KEY=
RECOGNITION_CONCURRENCY=4
VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL=deepseek-flash
VISION_PLUS_MODEL=deepseek-flash
VISION_MAX_MODEL=deepseek-flash
VISION_FINISH_CONFIRMATION_MODEL=deepseek-flash
VISION_THINKING_ENABLED=false
# Independent Bailian search credentials; never reuse the visual key.
# For a dedicated workspace, use its original ws-*.maas.aliyuncs.com endpoint.
SEARCH_API_KEY=
SEARCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_DELETION_ENDPOINT=
EBAY_MARKETPLACE_DELETION_VERIFICATION_TOKEN=
EBAY_NOTIFICATION_SIGNATURE_REQUIRED=true
CARD_SEARCH_ENABLED=true
CARD_SEARCH_MODEL=qwen-plus
VALUATION_SEARCH_MODEL=qwen-plus
VALUATION_SEARCH_TIMEOUT_SECONDS=90
VALUATION_WORKER_ENABLED=true
VALUATION_WORKER_POLL_SECONDS=2
VALUATION_VERIFY_SOURCES=true
VALUATION_CARDHOBBY_ONLY=false
VALUATION_SOURCE_VERIFY_TIMEOUT_SECONDS=8
# Optional independent search-index evidence providers. At least one key is
# required to discover auditable eBay item URLs/snippets outside the LLM.
SEARCH_INDEX_BRAVE_API_KEY=
SEARCH_INDEX_SERPAPI_KEY=
SEARCH_INDEX_TIMEOUT_SECONDS=12
SEARCH_INDEX_MAX_QUERIES=7
SEARCH_INDEX_CONCURRENCY=2
NBA_STATS_BASE_URL=https://stats.nba.com/stats
NEWS_RSS_URL_TEMPLATE=https://news.google.com/rss/search?q={player}+NBA&hl=en-US&gl=US&ceid=US:en
INJURY_RSS_URL_TEMPLATE=https://news.google.com/rss/search?q={player}+NBA+injury&hl=en-US&gl=US&ceid=US:en
UPLOAD_DIR=apps/api/uploads
MAX_IMAGE_BYTES=10485760
AUTH_COOKIE_NAME=card_platform_session
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_REGISTRATION_ENABLED=true
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
SCANNER_WORKER_ENABLED=true
SCANNER_WORKER_CONCURRENCY=4
SCANNER_WORKER_POLL_SECONDS=1
SCANNER_JOB_MAX_ATTEMPTS=3
SCANNER_JOB_DIR=data/scanner-jobs
# Optional. macOS defaults to ~/Library/Application Support/CardPlatform/nssdk.framework/Versions/A/nssdk
SCANNER_NSSDK_LIBRARY_PATH=
SCANNER_ORIENTATION_LOCAL_THRESHOLD=0.72
FLATBED_ML_ENABLED=false
FLATBED_ML_PYTHON=.runtime/flatbed-ml/bin/python
FLATBED_ML_WORKER_SCRIPT=scripts/flatbed_sam2_worker.py
FLATBED_ML_CHECKPOINT=.runtime/models/sam2.1_hiera_tiny.pt
FLATBED_ML_TIMEOUT_SECONDS=20
