POSTGRES_DB=card_platform
POSTGRES_USER=card_platform
POSTGRES_PASSWORD=card_platform
DATABASE_URL=postgresql://card_platform:card_platform@localhost:5432/card_platform
DEFAULT_CURRENCY=CNY
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
VISION_API_KEY=
RECOGNITION_CONCURRENCY=4
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-flash
CARD_SEARCH_ENABLED=true
CARD_SEARCH_MODEL=qwen-plus
VALUATION_SEARCH_MODEL=qwen-plus
VALUATION_SEARCH_TIMEOUT_SECONDS=90
VALUATION_WORKER_ENABLED=true
VALUATION_WORKER_POLL_SECONDS=2
VALUATION_VERIFY_SOURCES=true
VALUATION_SOURCE_VERIFY_TIMEOUT_SECONDS=8
NBA_STATS_BASE_URL=https://stats.nba.com/stats
NEWS_RSS_URL_TEMPLATE=https://news.google.com/rss/search?q={player}+NBA&hl=en-US&gl=US&ceid=US:en
INJURY_RSS_URL_TEMPLATE=https://news.google.com/rss/search?q={player}+NBA+injury&hl=en-US&gl=US&ceid=US:en
UPLOAD_DIR=uploads
MAX_IMAGE_BYTES=10485760
