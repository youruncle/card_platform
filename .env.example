POSTGRES_DB=card_platform
POSTGRES_USER=card_platform
POSTGRES_PASSWORD=card_platform
DATABASE_URL=postgresql://card_platform:card_platform@localhost:5432/card_platform
DEFAULT_CURRENCY=CNY
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
NBA_STATS_BASE_URL=https://stats.nba.com/stats
NEWS_RSS_URL_TEMPLATE=https://news.google.com/rss/search?q={player}+NBA&hl=en-US&gl=US&ceid=US:en
INJURY_RSS_URL_TEMPLATE=https://news.google.com/rss/search?q={player}+NBA+injury&hl=en-US&gl=US&ceid=US:en
UPLOAD_DIR=uploads
MAX_IMAGE_BYTES=10485760
