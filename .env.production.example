POSTGRES_DB=card_platform
POSTGRES_USER=card_platform
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://card_platform:replace-with-a-long-random-password@postgres:5432/card_platform
DEFAULT_CURRENCY=CNY
API_PORT=8000
WEB_PORT=3000
ALLOWED_ORIGINS=https://cards.example.com
NEXT_PUBLIC_API_URL=https://api.cards.example.com
NEXT_PUBLIC_SITE_URL=https://cards.example.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
NEWS_RSS_URL_TEMPLATE=https://news.google.com/rss/search?q={player}+NBA&hl=en-US&gl=US&ceid=US:en
INJURY_RSS_URL_TEMPLATE=https://news.google.com/rss/search?q={player}+NBA+injury&hl=en-US&gl=US&ceid=US:en
UPLOAD_DIR=/app/uploads
MAX_IMAGE_BYTES=10485760
