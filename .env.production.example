POSTGRES_DB=card_platform
POSTGRES_USER=card_platform
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://card_platform:replace-with-a-long-random-password@postgres:5432/card_platform
DEFAULT_CURRENCY=CNY
API_PORT=8000
WEB_PORT=3000
ALLOWED_ORIGINS=https://cards.example.com
NEXT_PUBLIC_API_URL=https://api.cards.example.com
NEXT_PUBLIC_SITE_URL=https://cards.example.com
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
VISION_API_KEY=
RECOGNITION_CONCURRENCY=4
VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL=deepseek-flash
VISION_PLUS_MODEL=deepseek-flash
VISION_MAX_MODEL=deepseek-flash
VISION_FINISH_CONFIRMATION_MODEL=deepseek-flash
VISION_THINKING_ENABLED=false
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.deepseek.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_DELETION_ENDPOINT=https://api.cards.example.com/v1/integrations/ebay/marketplace-account-deletion
EBAY_MARKETPLACE_DELETION_VERIFICATION_TOKEN=replace-with-32-to-80-alphanumeric-underscore-or-hyphen-characters
EBAY_NOTIFICATION_SIGNATURE_REQUIRED=true
CARD_SEARCH_ENABLED=true
CARD_SEARCH_MODEL=deepseek-flash
VALUATION_SEARCH_MODEL=deepseek-flash
VALUATION_SEARCH_TIMEOUT_SECONDS=90
VALUATION_WORKER_ENABLED=true
PURCHASE_COST_WORKER_ENABLED=true
VALUATION_WORKER_POLL_SECONDS=2
VALUATION_VERIFY_SOURCES=true
VALUATION_CARDHOBBY_ONLY=false
VALUATION_SOURCE_VERIFY_TIMEOUT_SECONDS=8
SEARCH_INDEX_BRAVE_API_KEY=
SEARCH_INDEX_SERPAPI_KEY=
SEARCH_INDEX_TIMEOUT_SECONDS=12
SEARCH_INDEX_MAX_QUERIES=7
SEARCH_INDEX_CONCURRENCY=2
NEWS_RSS_URL_TEMPLATE=https://news.google.com/rss/search?q={player}+NBA&hl=en-US&gl=US&ceid=US:en
INJURY_RSS_URL_TEMPLATE=https://news.google.com/rss/search?q={player}+NBA+injury&hl=en-US&gl=US&ceid=US:en
UPLOAD_DIR=/app/uploads
MAX_IMAGE_BYTES=10485760
AUTH_COOKIE_NAME=card_platform_session
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=true
# 首个管理员注册并认领旧卡库后应改为 false，再重启 API。
AUTH_REGISTRATION_ENABLED=true
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
SCANNER_WORKER_ENABLED=true
SCANNER_WORKER_CONCURRENCY=4
SCANNER_WORKER_POLL_SECONDS=1
SCANNER_JOB_MAX_ATTEMPTS=3
SCANNER_JOB_DIR=/app/scanner-jobs
SCANNER_NSSDK_LIBRARY_PATH=
SCANNER_ORIENTATION_LOCAL_THRESHOLD=0.72
